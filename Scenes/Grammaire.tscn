[gd_scene format=3]

[ext_resource type="Script" path="res://Scripts/Grammaire.gd" id="1"]

[node name="Grammaire" type="HBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 16
script = ExtResource("1")

[node name="Toc" type="PanelContainer" parent="."]
custom_minimum_size = Vector2(290, 0)
layout_mode = 2

[node name="Layout" type="VBoxContainer" parent="Toc"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="Header" type="HBoxContainer" parent="Toc/Layout"]
layout_mode = 2

[node name="Heading" type="Label" parent="Toc/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HeadingLabel"
text = "Contents"
vertical_alignment = 1

[node name="OrganizeButton" type="Button" parent="Toc/Layout/Header"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Reorder and edit articles"
focus_mode = 0
toggle_mode = true
text = "Edit"

[node name="Scroll" type="ScrollContainer" parent="Toc/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="TocList" type="VBoxContainer" parent="Toc/Layout/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1

[node name="AddButton" type="Button" parent="Toc/Layout"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Add an article at the end; move it with the arrows in Edit mode"
text = "+ New article"

[node name="Page" type="PanelContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3

[node name="Reader" type="VBoxContainer" parent="Page"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="Toolbar" type="HBoxContainer" parent="Page/Reader"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MatchLabel" type="Label" parent="Page/Reader/Toolbar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"HintLabel"
vertical_alignment = 1
text_overrun_behavior = 3

[node name="SearchInput" type="LineEdit" parent="Page/Reader/Toolbar"]
unique_name_in_owner = true
custom_minimum_size = Vector2(280, 0)
layout_mode = 2
tooltip_text = "Search rules, tables and examples (Ctrl+F). Escape to clear."
placeholder_text = "Search the grammar…"
clear_button_enabled = true

[node name="ContentScroll" type="ScrollContainer" parent="Page/Reader"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Margin" type="MarginContainer" parent="Page/Reader/ContentScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/margin_right = 14

[node name="Content" type="VBoxContainer" parent="Page/Reader/ContentScroll/Margin"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Editor" type="VBoxContainer" parent="Page"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 12

[node name="EditorHeading" type="Label" parent="Page/Editor"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"HeadingLabel"
text = "New article"

[node name="TitleRow" type="HBoxContainer" parent="Page/Editor"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleInput" type="LineEdit" parent="Page/Editor/TitleRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
placeholder_text = "Title, e.g. 2.10  Commands"

[node name="LevelInput" type="OptionButton" parent="Page/Editor/TitleRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(150, 0)
layout_mode = 2
tooltip_text = "A chapter groups the articles that follow it"

[node name="BodyInput" type="TextEdit" parent="Page/Editor"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
placeholder_text = "- The bare verb at the start of a sentence gives a command.
Bring great fortune! → Pirol mulenop"
wrap_mode = 1

[node name="Footer" type="HBoxContainer" parent="Page/Editor"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="DeleteArticleButton" type="Button" parent="Page/Editor/Footer"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DangerButton"
text = "Delete article"

[node name="Spacer" type="Control" parent="Page/Editor/Footer"]
layout_mode = 2
